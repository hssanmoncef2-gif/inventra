# ============================================================
# INVENTORY APP - ENVIRONMENT CONFIGURATION
# Copy this file to .env and fill in your values
# ============================================================

# Server
PORT=5000
NODE_ENV=development

# MongoDB (use MongoDB Atlas free tier: https://cloud.mongodb.com)
MONGODB_URI=mongodb://localhost:27017/inventory_db

# JWT Secrets (generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=your_jwt_secret_here_change_this_in_production
JWT_REFRESH_SECRET=your_refresh_secret_here_change_this_in_production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Default Admin (created on first run)
DEFAULT_ADMIN_EMAIL=hssanmoncef@gmail.com
DEFAULT_ADMIN_PASSWORD=13579Moncef

# Chatbot (Anthropic API - free tier or use own key)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# File Uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880

# Backup
BACKUP_DIR=backups
BACKUP_CRON=0 2 * * *

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000
