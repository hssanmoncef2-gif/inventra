# ═══════════════════════════════════════════════════════════════
#  INVENTRA — Backend Environment Variables
#  Copy this file to .env and adjust values
# ═══════════════════════════════════════════════════════════════

PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/inventory_db

# JWT Secrets (change these in production!)
JWT_SECRET=inventra-jwt-secret-change-in-production-please
JWT_REFRESH_SECRET=inventra-refresh-secret-change-in-production-please
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Default Admin Account
DEFAULT_ADMIN_EMAIL=admin@inventra.local
DEFAULT_ADMIN_PASSWORD=Admin1234!

# ── AI Chatbot (Ollama — FREE & Open Source) ──────────────────
# No API key needed! Ollama runs locally.
# When using Docker: OLLAMA_URL=http://ollama:11434
# When running locally: OLLAMA_URL=http://localhost:11434
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Available models (pull with: ollama pull <model>):
#   llama3.2        — 2GB, fast, great quality (recommended)
#   llama3.2:1b     — 1.3GB, fastest, lower quality
#   mistral         — 4.1GB, excellent quality
#   phi3            — 2.3GB, great for reasoning
#   gemma2          — 5.4GB, Google's model

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# File uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880

# Backups
BACKUP_DIR=backups
BACKUP_CRON=0 2 * * *
